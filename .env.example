# Required for live Fingrid ingestion
FINGRID_API_KEY=

# Strongly recommended: day-ahead price + ENTSO-E load/generation/hydro/outage context
ENTSOE_API_TOKEN=

# Optional source endpoints
FINGRID_API_BASE=https://data.fingrid.fi/api
ENTSOE_API_BASE=https://web-api.tp.entsoe.eu/api
OPENMETEO_API_BASE=https://api.open-meteo.com/v1/forecast
FMI_WFS_BASE=https://opendata.fmi.fi/wfs

# Hourly production scheduler: fetch shortly after each full UTC hour and issue
# the nominal full-hour batch. The real fetched-at time is archived separately.
TE_BALANCEAI_CYCLE_SECOND=75

# Live source windows
TE_BALANCEAI_LIVE_LOOKBACK_HOURS=36
TE_BALANCEAI_LIVE_FORECAST_HOURS=72
TE_BALANCEAI_SETTLEMENT_LAG_MINUTES=75

# V6 multi-window self-learning: fast / regime / stable
TE_BALANCEAI_ADAPT_WINDOWS_HOURS=24,168,336
TE_BALANCEAI_ADAPT_WINDOW_WEIGHTS=0.50,0.30,0.20

# Drift detection and drift-triggered challenger retraining
TE_BALANCEAI_DRIFT_MAE_RATIO=1.35
TE_BALANCEAI_DRIFT_COVERAGE_DEVIATION=0.12
TE_BALANCEAI_DRIFT_RETRAIN_COOLDOWN_HOURS=6

# Full challenger retraining. Hourly adaptive correction still happens each cycle.
TE_BALANCEAI_ENABLE_FULL_RETRAIN=1
TE_BALANCEAI_FULL_RETRAIN_HOURS=24
TE_BALANCEAI_MIN_RETRAIN_ORIGINS=48
TE_BALANCEAI_RETRAIN_LOOKBACK_DAYS=90
TE_BALANCEAI_PROMOTION_MIN_GAIN=0.005
TE_BALANCEAI_MAX_METRIC_REGRESSION=0.05
TE_BALANCEAI_RETRAIN_EXTRA_MIN_COVERAGE=0.35

# Optional live public sources
TE_BALANCEAI_USE_OPENMETEO=1
TE_BALANCEAI_USE_FMI=1
TE_BALANCEAI_USE_ENTSOE_EXTENDED=1
TE_BALANCEAI_ARCHIVE_RAW=1

# Model threads; 1 is safest for Windows/hackathon laptops
TE_BALANCEAI_THREADS=1

# Optional read-only API security
TE_BALANCEAI_API_KEY=
TE_BALANCEAI_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# V7 daily learning checkpoint (Europe/Helsinki local time)
TE_BALANCEAI_DAILY_LEARNING_LOCAL_HOUR=14
TE_BALANCEAI_DAILY_LEARNING_LOCAL_MINUTE=0
TE_BALANCEAI_DAILY_MIN_EVALUATIONS=32

# V8 optional no-key FI day-ahead spot fallback for hackathon/demo.
# Prefer ENTSO-E or licensed Nord Pool in a production trading environment.
TE_BALANCEAI_USE_PUBLIC_SPOT_FALLBACK=1
PUBLIC_SPOT_API_BASE=https://sahkonhintahuomenna.fi/api/v1/fi

# V9: no-key ENTSO-E MCP/JSON live source. This is a third-party cache of ENTSO-E
# and native TSO feeds. It is production-live only; locked challenge backtests do
# not reconstruct history from today's MCP archive.
TE_BALANCEAI_USE_ENTSOE_MCP=1
ENTSOE_MCP_API_BASE=https://entsoemcp.com/api/series
ENTSOE_MCP_URL=https://entsoemcp.com/mcp
TE_BALANCEAI_ENTSOE_MCP_TIMEOUT_SECONDS=8

# V9 pooled conformal live interval calibration. These values only affect the
# production self-learning layer, never the organizer-scored frozen backtest.
TE_BALANCEAI_CONFORMAL_TARGET_COVERAGE=0.80
TE_BALANCEAI_CONFORMAL_MIN_SAMPLES=8
TE_BALANCEAI_CONFORMAL_FULL_STRENGTH_SAMPLES=48
TE_BALANCEAI_CONFORMAL_MAX_EXPAND_EUR=250
TE_BALANCEAI_DRIFT_MIN_SAMPLES=24
TE_BALANCEAI_GLOBAL_ADAPT_MIN_SAMPLES=8
TE_BALANCEAI_RELIABILITY_PRIOR_SAMPLES=24

# V11 challenger tournament
TE_BALANCEAI_RETRAIN_CAL_ORIGINS=12
TE_BALANCEAI_RETRAIN_EVAL_ORIGINS=12
TE_BALANCEAI_PROMOTION_MIN_MAE_GAIN=0.002
TE_BALANCEAI_ENABLE_STRONG_P50_CHALLENGER=1
